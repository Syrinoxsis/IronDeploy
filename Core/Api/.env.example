# IronAPI settings
IRONAPI_ACCESS_MODE=http_direct
IRONAPI_BIND_HOST=0.0.0.0
IRONAPI_PORT=8000
IRONAPI_ACCESS_LOG=false
IRONAPI_ALLOWED_CLIENT_NETWORKS=192.0.2.0/24
# Browser authentication cookie. SetupWeb derives this from the access mode:
# false for direct HTTP and true for HTTPS through an external reverse proxy.
IRONAPI_COOKIE_SECURE=false
# Deployment Bearer lifecycle. Login authorization must be consumed by /begin
# within the first window. The total timeout is a hard, non-sliding limit from
# /begin through WinPE, Windows Setup, and post-install.
IRONAPI_DEPLOYMENT_AUTHORIZATION_TIMEOUT_MINUTES=10
IRONAPI_DEPLOYMENT_TIMEOUT_MINUTES=90
# Server-side SMB credentials. SetupWeb writes the real values to Api\.env;
# they are returned only to an authenticated, active WinPE deployment.
IRONAPI_SMB_SHARE_PATH=\\DEPLOY-SERVER\IronDeploy
IRONAPI_SMB_USER=DEPLOY-SERVER\iron_ro
IRONAPI_SMB_PASSWORD=CHANGE_ME_RUN_SETUPWEB

# Portable defaults. Keep these inside the IronDeploy directory unless state
# must deliberately live somewhere else.
IRONAPI_DATABASE_URL=sqlite:///{IRONDEPLOY_ROOT}/Data/irondeploy.db
IRONAPI_ODJ_BLOB_DIR={IRONDEPLOY_ROOT}\ODJ\pending
IRONAPI_NAME_PREFIX=pc
IRONAPI_NAME_WIDTH=5
IRONAPI_NAME_START=1

# LDAP is used for name suggestions and ODJ existing-account detection.
# Login and password are read from the Windows Credential Manager generic
# credential named by IRONAPI_LDAP_CREDENTIAL_TARGET.
IRONAPI_LDAP_SERVER=dc01.example.test
IRONAPI_LDAP_BASE_DN=DC=example,DC=test
IRONAPI_LDAP_CREDENTIAL_TARGET=IronDeploy-LDAP
IRONAPI_LDAP_USE_SSL=false
IRONAPI_LDAP_CONNECT_TIMEOUT=5

# Offline Domain Join provisioning. djoin.exe runs as the IronAPI process
# identity, which must have permission to create computer accounts in this OU.
IRONAPI_ODJ_DOMAIN=example.test
IRONAPI_ODJ_MACHINE_OU=OU=Workstations,OU=Clients,DC=example,DC=test
IRONAPI_ODJ_DJOIN_PATH=C:\Windows\System32\djoin.exe
IRONAPI_ODJ_PROVISION_TIMEOUT=60
